# ATLAS Command Center Environment Configuration
# Copy this file to .env or .env.local to configure backend connections.

# FastAPI REST API Base Endpoint URL (Leave blank to use built-in DEMO MODE)
VITE_API_BASE_URL=http://127.0.0.1:8000

# ATLAS Live Events WebSocket Endpoint URL (Leave blank to use built-in DEMO MODE)
VITE_WS_URL=ws://127.0.0.1:8000/ws/events
